# ============================================================================
# CMS Docker 設定檔
#   `cms.ps1 init` / `cms.sh init` 會複製成 .env 並自動填入隨機密碼。
#   修改後執行 `up` 即可套用（容器會自動重建）。
# ============================================================================

# ---- 密碼（init 會自動產生，請妥善保存 .env）----------------------------------
# 資料庫密碼：只在資料庫「第一次建立」時生效，之後要改請見 README。
CMS_DB_PASSWORD=
# 管理介面(:8889) 初始帳號；只在帳號不存在時建立，之後改密碼請在管理介面操作。
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=
# 排名網站(:8890) 寫入用帳密（CMS 內部使用）
CMS_RANKING_USERNAME=ranking
CMS_RANKING_PASSWORD=
# Cookie 加密金鑰（32 個十六進位字元）；留空則第一次啟動時自動產生並保存。
CMS_SECRET_KEY=

# ---- 考場 ------------------------------------------------------------------
# ALL：多考場模式，新增考場後不必重啟，考生在首頁選擇考場（建議平常使用）
# 數字：只開放該考場 ID，並啟用 ProxyService 把成績送到排名網站（正式比賽用）
CMS_CONTEST_ID=ALL
# 是否啟動排名網站 RankingWebServer（true/false）
CMS_RANKING=false

# ---- 效能 ------------------------------------------------------------------
# 同時評測的 Worker 數量。建議不超過實體核心數的一半，時間量測才穩定。
CMS_WORKERS=4

# ---- 對外連接埠 --------------------------------------------------------------
# *_BIND=0.0.0.0 代表區網可連；127.0.0.1 代表只有本機可連。
CWS_BIND=0.0.0.0
CWS_PORT=8888
AWS_BIND=127.0.0.1
AWS_PORT=8889
RWS_BIND=0.0.0.0
RWS_PORT=8890
# 前面有 nginx 等反向代理時設為 1（CMS 才會記錄考生真實 IP）
CMS_NUM_PROXIES=0

# ---- 其他 ------------------------------------------------------------------
TZ=Asia/Taipei
# CMS 服務日誌保留天數（0 = 不清理）
CMS_LOG_RETENTION_DAYS=30

# ---- 建置參數（通常不需要改）--------------------------------------------------
# CMS 版本與對應 commit（改版本時請同步修改或清空 CMS_COMMIT）
CMS_REF=v1.5.1
CMS_COMMIT=7c9fec8aa1a25ec93d624aebf815804dd93df9db
CMS_IMAGE=cms-local:v1.5.1
JDK_PACKAGE=openjdk-11-jdk-headless
# true 會額外安裝 PyPy3 / PHP / Rust / Haskell / C#
EXTRA_LANGS=false
POSTGRES_IMAGE=postgres:16-bookworm
